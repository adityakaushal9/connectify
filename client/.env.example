VITE_SERVER_URL=http://localhost:5000
# NOTE: no VITE_LIVEKIT_URL — the SFU URL comes from the server token response,
# so configure LiveKit in exactly one place (server LIVEKIT_URL).
# Mesh-path TURN fallback (strict NATs). NEVER set VITE_ICE_SERVERS together with these (early-return skips TURN).
# VITE_TURN_URL=turn:openrelay.metered.ca:443?transport=tcp
# VITE_TURN_USER=openrelay
# VITE_TURN_PASS=openrelay
