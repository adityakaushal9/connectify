PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/connectify
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
NODE_ENV=development # production on Render (enables Secure cookies)
MAX_PEERS=6 # mesh cap; larger rooms need an SFU
# LiveKit Cloud (free tier) — SFU path only; get from cloud.livekit.io dashboard
LIVEKIT_URL=wss://your-subdomain.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
